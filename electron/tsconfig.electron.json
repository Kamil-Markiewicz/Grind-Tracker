{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "node",
        "outDir": "./../dist/electron",
        "rootDir": "..",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "src/**/*.ts",
        "../shared/**/*.ts"
    ],
    "exclude": [
        "node_modules",
        //"/app/components/**/*.ts",
        //"src/app/services/**/*.ts"
        "../angular/**/*.ts"
    ]
}