{
    "name": "grind-tracker",
    "version": "0.1.4",
    "description": "Cross-platform grind tracking app.",
    "keywords": [
        "electron",
        "angular",
        "cross-platform"
    ],
    "homepage": "https://github.com/Kamil-Markiewicz/Grind-Tracker#readme",
    "bugs": {
        "url": "https://github.com/Kamil-Markiewicz/Grind-Tracker/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Kamil-Markiewicz/Grind-Tracker.git"
    },
    "license": "UNLICENSED",
    "author": "Kamil Markiewicz <author@domain.com>",
    "main": "dist/electron/src/main-electron.js",
    "scripts": {
        "ng": "ng",
        "ng-start": "ng serve",
        "ng-build": "ng build",
        "watch": "ng build --watch --configuration development",
        "start-angular": "ng build --base-href ./angular",
        "start": "ng build --base-href ./ && tsc -p electron/tsconfig.electron.json && electron .",
        "test": "ng test",
        "package": "electron-forge package",
        "make": "electron-forge make",
        "build": "electron-builder --config build/electron-builder.win.json --config build/electron-builder.linux.json",
        "build:win": "electron-builder --config build/electron-builder.win.json",
        "build:linux": "electron-builder --config build/electron-builder.linux.json",
        "build:linux.flatpak": "electron-builder --config build/electron-builder.linux.flatpak.json",
        "build:mac": "electron-builder --config build/electron-builder.mac.json",
        "generate-claude": "node project/generate-claude-md.cjs"
    },
    "packageManager": "npm@11.11.0",
    "devDependencies": {
        "@angular/build": "^21.2.2",
        "@angular/cli": "^21.2.2",
        "@angular/compiler-cli": "^21.2.2",
        "@electron-forge/cli": "^7.11.1",
        "@electron-forge/maker-deb": "^7.11.1",
        "@electron-forge/maker-rpm": "^7.11.1",
        "@electron-forge/maker-squirrel": "^7.11.1",
        "@electron-forge/maker-zip": "^7.11.1",
        "@electron-forge/plugin-auto-unpack-natives": "^7.11.1",
        "@electron-forge/plugin-fuses": "^7.11.1",
        "@electron/fuses": "^1.8.0",
        "electron": "^40.8.0",
        "electron-builder": "^26.8.1",
        "jsdom": "^28.1.0",
        "prettier": "^3.8.1",
        "typescript": "~5.9.2",
        "vitest": "^4.0.18"
    },
    "dependencies": {
        "@angular/common": "^21.2.0",
        "@angular/compiler": "^21.2.0",
        "@angular/core": "^21.2.0",
        "@angular/forms": "^21.2.2",
        "@angular/platform-browser": "^21.2.0",
        "@angular/router": "^21.2.2",
        "bootstrap": "^5.3.8",
        "electron-squirrel-startup": "^1.0.1",
        "rxjs": "~7.8.0",
        "tslib": "^2.8.1"
    }
}
